                        "lookup_key": "np_volunteer_guide_button",
                        "button_text": "Sign up for a shift",
                        "button_color": "#00A84D"
                    },
                    "status": "draft",
                    "locale": "en"
                },
                {
                    "data": {
                        "text": "<h2>Where Your Donation Goes</h2>",
                        "type": "text",
                        "lookup_key": "np_impact_report_title"
                    },
                    "status": "draft",
                    "locale": "en"
                },
                {
                    "data": {
                        "text": "<p>Last year 87 cents of every dollar went directly to programs: 41% food security, 28% housing support, 18% youth education.</p><p>The remaining 13% covers the staff and systems that keep those programs running.</p>",
