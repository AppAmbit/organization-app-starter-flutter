        {
            "display_name": "Content Detail Items",
            "entries": [
                {
                    "data": {
                        "text": "<h2>Volunteer With Us</h2>",
                        "type": "text",
                        "lookup_key": "np_volunteer_guide_title"
                    },
                    "status": "draft",
                    "locale": "en"
                },
                {
                    "data": {
                        "text": "<p>Every Saturday morning our teams pack meals, run the community garden and drive neighbors to appointments. No experience needed — we train you on site.</p><h3>What a shift looks like</h3><p>Three hours, a short briefing, and a team lead who stays with you the whole time.</p><h3>What to bring</h3><p>Closed shoes, a water bottle, and an ID for the sign-in sheet.</p>",
                        "type": "text",
                        "lookup_key": "np_volunteer_guide_body"
                    },
                    "status": "draft",
                    "locale": "en"
                },
                {
                    "data": {
                        "text": "<p></p>",
                        "type": "image",
                        "button_url": null,
                        "lookup_key": "np_volunteer_guide_image",
                        "button_text": null,
                        "banner_image": null,
                        "banner_video": null,
                        "button_color": null
                    },
                    "status": "draft",
                    "locale": "en"
